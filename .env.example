# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Razorpay TEST credentials for local testing. Never commit real values.
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_TEST_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_YOUR_TEST_WEBHOOK_SECRET

# Transactional email (Resend). Set these in your hosting provider as well.
RESEND_API_KEY=re_REPLACE_WITH_YOUR_RESEND_API_KEY
EMAIL_FROM="BizPilot Studio <account@mail.bizpilotstudio.com>"
SUPPORT_EMAIL=vichhiparth2@gmail.com
APP_BASE_URL=http://localhost:3000
GOOGLE_SITE_VERIFICATION=
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Google Gemini AI business-plan reviews (server-side only; never expose in client code)
GEMINI_API_KEY=REPLACE_WITH_YOUR_GOOGLE_AI_STUDIO_KEY
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_TRIAL_MODEL=gemini-3.5-flash-lite
